{
  "name": "Bookings and No-Show Recovery - Error Alert",
  "nodes": [
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "{{CONFIG.slack_alerts_channel}}"
        },
        "messageType": "text",
        "text": "={{ 'Workflow error: ' + ($json.error && $json.error.message || 'unknown') + ' in node ' + ($json.error && $json.error.node && $json.error.node.name || 'unknown') + ' (workflow ' + ($json.workflow && $json.workflow.name || 'unknown') + ')' }}",
        "options": {}
      },
      "id": "n73",
      "name": "Slack alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.7,
      "position": [
        1080,
        960
      ],
      "credentials": {
        "slackApi": {
          "id": "1",
          "name": "{{CONFIG.slack_credential}}"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "{{CONFIG.slack_enabled}}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "n73a",
      "name": "Alert?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        960
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendTemplate",
        "phoneNumberId": "{{CONFIG.whatsapp_phone_number_id}}",
        "recipientPhoneNumber": "{{CONFIG.owner_whatsapp_number}}",
        "template": "{{CONFIG.whatsapp_template_owner}}|{{CONFIG.whatsapp_template_language}}",
        "components": {
          "component": [
            {
              "type": "body",
              "bodyParameters": {
                "parameter": [
                  {
                    "type": "text",
                    "text": "Workflow error"
                  },
                  {
                    "type": "text",
                    "text": "={{ $json.error.node.name }}"
                  },
                  {
                    "type": "text",
                    "text": "={{ $json.error.message }}"
                  },
                  {
                    "type": "text",
                    "text": "={{ $json.workflow.name }}"
                  },
                  {
                    "type": "text",
                    "text": "n/a"
                  }
                ]
              }
            }
          ]
        },
        "messagingProduct": "whatsapp"
      },
      "id": "n73b",
      "name": "Owner alert",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [
        720,
        960
      ],
      "credentials": {
        "whatsAppApi": {
          "id": "1",
          "name": "{{CONFIG.whatsapp_credential}}"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {},
      "id": "t06",
      "name": "Error trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        900,
        0
      ]
    }
  ],
  "connections": {
    "Error trigger": {
      "main": [
        [
          {
            "node": "Alert?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Alert?": {
      "main": [
        [
          {
            "node": "Slack alert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Owner alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": [],
  "meta": {}
}